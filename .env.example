# Application Settings
PROJECT_NAME="GJ Spaces CRM API"
BASE_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/GJ_spaces

# SMTP Email Configuration 
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
TO_EMAIL=your_email@gmail.com
FROM_NAME=GJ_Spaces

# JWT Configuration
JWT_SECRET_KEY=generate_and_replace_with_a_secure_32_byte_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# ADMIN CREDENTIALS
ADMIN_EMAIL=admin@gjspaces.com
ADMIN_PASSWORD=password1234
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_CONTACT_NUMBER=+910000000000
